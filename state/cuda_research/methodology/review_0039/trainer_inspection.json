    "226": "            o, r, d, t, info, env_id, mask = self.vecenv.recv()",
    "227": "",
    "228": "            profile('eval_misc', epoch)",
    "229": "            env_id = slice(env_id[0], env_id[-1] + 1)",
    "230": "",
    "231": "            done_mask = d + t # TODO: Handle truncations separately",
    "232": "            self.global_step += int(mask.sum())",
    "233": "",
    "234": "            profile('eval_copy', epoch)",
    "235": "            o = torch.as_tensor(o)",
    "236": "            o_device = o.to(device)#, non_blocking=True)",
    "237": "            r = torch.as_tensor(r).to(device)#, non_blocking=True)",
    "238": "            d = torch.as_tensor(d).to(device)#, non_blocking=True)",
    "239": "",
    "240": "            profile('eval_forward', epoch)",
    "241": "            with torch.no_grad(), self.amp_context:",
    "242": "                state = dict(",
    "243": "                    reward=r,",
    "244": "                    done=d,",
    "245": "                    env_id=env_id,",
    "246": "                    mask=mask,",
    "247": "                )",
    "248": "",
    "249": "                if config['use_rnn']:",
    "250": "                    state['lstm_h'] = self.lstm_h[env_id.start]",
    "251": "                    state['lstm_c'] = self.lstm_c[env_id.start]",
    "252": "",
    "253": "                logits, value = self.policy.forward_eval(o_device, state)",
    "254": "                action, logprob, _ = pufferlib.pytorch.sample_logits(logits)",
    "255": "                r = torch.clamp(r, -1, 1)",
    "256": "",
    "257": "            profile('eval_copy', epoch)",
    "258": "            with torch.no_grad():",
    "259": "                if config['use_rnn']:",
    "260": "                    self.lstm_h[env_id.start] = state['lstm_h']",
    "261": "                    self.lstm_c[env_id.start] = state['lstm_c']",
    "262": "",
    "263": "                # Fast path for fully vectorized envs",
    "264": "                l = self.ep_lengths[env_id.start].item()",
    "265": "                batch_rows = slice(self.ep_indices[env_id.start].item(), 1+self.ep_indices[env_id.stop - 1].item())",
    "266": "",
    "267": "                if config['cpu_offload']:",
    "268": "                    self.observations[batch_rows, l] = o",
    "269": "                else:",
    "270": "                    self.observations[batch_rows, l] = o_device",
    "271": "",
    "272": "                self.actions[batch_rows, l] = action",
    "273": "                self.logprobs[batch_rows, l] = logprob",
    "274": "                self.rewards[batch_rows, l] = r",
    "275": "                self.terminals[batch_rows, l] = d.float()",
    "276": "                self.values[batch_rows, l] = value.flatten()",
    "277": ""
